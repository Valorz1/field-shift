# NASA Earthdata credentials (only needed for services/endpoints that require them)
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=

# Local model runner
MODEL_BASE_URL=http://model:11434
MODEL_NAME=gemma4:e4b

# Optional service configuration
APP_ENV=development

# Map (frontend). Get a free token at mapbox.com. Keep the real one in .env only.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Backend API (frontend). Defaults to http://localhost:8000 when empty.
NEXT_PUBLIC_API_URL=
